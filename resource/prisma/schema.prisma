generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum JobStatus {
    ACTIVE
    INACTIVE
    @@map("status")
}

model Job {
    id         String       @id
    title       String
    description String
    status JobStatus
    link String
    createdAt DateTime
    updatedAt DateTime
    deletedAt DateTime?
    @@map("tb_jobs")
}