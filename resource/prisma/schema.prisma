generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "job_management", "report_management"]
}

model Job {
  id                    String                  @id
  title                 String
  company               String
  status                JobStatus
  url                   String
  location              String
  createdAt             DateTime
  updatedAt             DateTime
  deletedAt             DateTime?
  JobApplicationProcess JobApplicationProcess[]
  FavoriteJob           FavoriteJob[]

  @@map("tb_jobs")
  @@schema("job_management")
}

model User {
  id                    String                  @id
  firstName             String
  lastName              String
  email                 String                  @unique
  password              String
  isActive              Boolean
  createdAt             DateTime
  updatedAt             DateTime
  salt                  String
  role                  RoleUser
  deletedAt             DateTime?
  JobApplicationProcess JobApplicationProcess[]
  FavoriteJob           FavoriteJob[]

  @@map("tb_users")
  @@schema("identity")
}

model JobApplicationProcess {
  id        String                       @id
  title     String
  url       String
  jobId     String
  company   String
  userId    String
  note      String?
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?
  status    JobApplicationProcessStatus?
  user      User?                        @relation(fields: [userId], references: [id], onDelete: NoAction)
  job       Job?                         @relation(fields: [jobId], references: [id], onDelete: NoAction)

  @@map("tb_job_application_processes")
  @@schema("job_management")
}

model FavoriteJob {
  id        String    @id
  userId    String
  jobId     String
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("tb_favorite_jobs")
  @@schema("job_management")
}

view UserJobApplicationAvg {
  userId        String  @id
  fullName      String?
  notProcessing Decimal @db.Decimal
  applied       Decimal @db.Decimal
  inProgress    Decimal @db.Decimal
  approved      Decimal @db.Decimal
  rejected      Decimal @db.Decimal
  closed        Decimal @db.Decimal

  @@map("tb_user_job_application_avg")
  @@schema("report_management")
}

enum JobStatus {
  ACTIVE
  INACTIVE

  @@map("status")
  @@schema("job_management")
}

enum RoleUser {
  ADMIN
  USER

  @@map("role_user")
  @@schema("identity")
}

enum JobApplicationProcessStatus {
  NOT_PROCESSING
  APPLIED
  IN_PROGRESS
  APPROVED
  REJECTED
  CLOSED

  @@map("status_job_application_processes")
  @@schema("job_management")
}
