{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "baseUrl": ".",
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "lib": [
      "es2020"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "paths": {
      "@sharedModule/*": [
        "./src/module/shared/module/*"
      ],
      "@identityModule/*": [
        "./src/module/identity/*"
      ],
      "@jobManagementModule/*": [
        "./src/module/job-management/*"
      ],
      "@sharedLibs/*": [
        "./src/module/shared/*"
      ],
      "@reportManagementModule/*": [
        "./src/module/report-management/*"
      ],
      "@testInfra/*": [
        "./test/*"
      ],
      "@resource/*": [
        "./resource/*"
      ]
    },
    "removeComments": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "target": "es2020"
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "database/**/*"
  ]
}